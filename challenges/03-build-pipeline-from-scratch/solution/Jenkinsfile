pipeline {
    agent any

    stages {
        stage('Install') {
            steps {
                sh 'cd challenges/03-build-pipeline-from-scratch && pip3 install -r requirements.txt'
            }
        }
        stage('Test') {
            steps {
                sh 'cd challenges/03-build-pipeline-from-scratch && python3 -m pytest test_app.py -v'
            }
        }
        stage('Run') {
            steps {
                sh 'cd challenges/03-build-pipeline-from-scratch && python3 app.py'
            }
        }
    }

    post {
        success {
            echo 'Temperature converter built and tested successfully!'
        }
        failure {
            echo 'Build failed — check the console output.'
        }
    }
}
