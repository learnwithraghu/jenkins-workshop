pipeline {
    agent any

    stages {
        stage('Install') {
            steps {
                sh '''
                    cd challenges/03-create-full-pipeline-job
                    python3 -m venv .venv
                    .venv/bin/pip install -r requirements.txt
                '''
            }
        }
        stage('Test') {
            steps {
                sh 'cd challenges/03-create-full-pipeline-job && .venv/bin/python -m pytest test_app.py -v'
            }
        }
        stage('Run') {
            steps {
                sh 'cd challenges/03-create-full-pipeline-job && .venv/bin/python app.py'
            }
        }
    }

    post {
        success {
            echo 'Build succeeded!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
