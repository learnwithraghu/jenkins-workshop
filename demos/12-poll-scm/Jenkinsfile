pipeline {
    agent any

    // After the first manual build, Jenkins polls GitHub about every 5 minutes.
    // A push to main starts a new build when SCM changes are detected.
    triggers {
        pollSCM('H/5 * * * *')
    }

    stages {
        stage('Run') {
            steps {
                sh 'cd demos/12-poll-scm && python3 app.py'
            }
        }
    }

    post {
        success {
            echo 'Poll SCM demo build succeeded!'
        }
        failure {
            echo 'Build failed — check console output.'
        }
    }
}
