pipeline {
    agent any

    parameters {
        string(name: 'S3_BUCKET', defaultValue: '', description: 'Existing S3 bucket name in us-east-1 (website hosting enabled)')
        password(name: 'AWS_ACCESS_KEY_ID', defaultValue: '', description: 'AWS Access Key ID (entered at build time)')
        password(name: 'AWS_SECRET_ACCESS_KEY', defaultValue: '', description: 'AWS Secret Access Key (entered at build time)')
    }

    environment {
        APP_DIR            = 'demos/14-deploy-s3'
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_REGION         = 'us-east-1'
    }

    stages {
        stage('Generate') {
            steps {
                script {
                    if (!params.S3_BUCKET?.trim()) {
                        error('S3_BUCKET is empty. Use Build with Parameters and enter your bucket name.')
                    }
                    if (!params.AWS_ACCESS_KEY_ID || !params.AWS_SECRET_ACCESS_KEY) {
                        error('Enter AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY on Build with Parameters.')
                    }
                }
                sh '''
                    cd "$APP_DIR"
                    S3_BUCKET="${S3_BUCKET}" \
                    BUILD_NUMBER="${BUILD_NUMBER}" \
                    JOB_NAME="${JOB_NAME}" \
                    python3 generate_site.py
                '''
            }
        }

        stage('Install AWS CLI') {
            steps {
                sh '''
                    export PATH="$HOME/.local/bin:$PATH"

                    if command -v aws >/dev/null 2>&1; then
                        echo "AWS CLI already installed"
                        aws --version
                        exit 0
                    fi

                    echo "AWS CLI not found — installing v2 for this Jenkins user"
                    ARCH=$(uname -m)
                    if [ "$ARCH" = "aarch64" ]; then
                        ZIP_URL="https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip"
                    else
                        ZIP_URL="https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip"
                    fi

                    curl -fsSL "$ZIP_URL" -o /tmp/awscliv2.zip
                    rm -rf /tmp/aws-cli-src
                    mkdir -p /tmp/aws-cli-src
                    python3 -m zipfile -e /tmp/awscliv2.zip /tmp/aws-cli-src
                    mkdir -p "$HOME/.local/bin"
                    /tmp/aws-cli-src/aws/install -i "$HOME/.local/aws-cli" -b "$HOME/.local/bin" --update
                    aws --version
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo "Upload site/index.html to s3://${params.S3_BUCKET}/index.html (region us-east-1 / N. Virginia)"
                sh '''
                    export PATH="$HOME/.local/bin:$PATH"
                    set +x
                    export AWS_ACCESS_KEY_ID="$AWS_ACCESS_KEY_ID"
                    export AWS_SECRET_ACCESS_KEY="$AWS_SECRET_ACCESS_KEY"
                    export AWS_DEFAULT_REGION="us-east-1"
                    export AWS_REGION="us-east-1"

                    aws s3 cp "$APP_DIR/site/index.html" \
                        "s3://${S3_BUCKET}/index.html" \
                        --region us-east-1 \
                        --content-type text/html

                    set -x
                    echo "Uploaded s3://${S3_BUCKET}/index.html"
                    echo "Open: http://${S3_BUCKET}.s3-website-us-east-1.amazonaws.com"
                '''
            }
        }
    }

    post {
        success {
            echo "Deployed to s3://${params.S3_BUCKET}/index.html in us-east-1 — http://${params.S3_BUCKET}.s3-website-us-east-1.amazonaws.com"
        }
        failure {
            echo 'Check: Build with Parameters (S3_BUCKET + Access Key + Secret), AWS CLI install stage, and bucket website hosting / public read in us-east-1.'
        }
    }
}
