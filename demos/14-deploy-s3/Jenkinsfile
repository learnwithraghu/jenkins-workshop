pipeline {
    agent any

    parameters {
        string(name: 'S3_BUCKET', defaultValue: '', description: 'Existing S3 bucket name (website hosting enabled)')
        string(name: 'AWS_REGION', defaultValue: 'us-east-1', description: 'AWS region of the bucket')
        string(name: 'SITE_TITLE', defaultValue: 'Jenkins Workshop Site', description: 'Title shown on index.html')
    }

    environment {
        APP_DIR = 'demos/14-deploy-s3'
    }

    stages {
        stage('Generate') {
            steps {
                script {
                    if (!params.S3_BUCKET?.trim()) {
                        error('S3_BUCKET is empty. Use Build with Parameters and enter your bucket name.')
                    }
                }
                sh '''
                    cd "$APP_DIR"
                    SITE_TITLE="${SITE_TITLE}" \
                    S3_BUCKET="${S3_BUCKET}" \
                    BUILD_NUMBER="${BUILD_NUMBER}" \
                    JOB_NAME="${JOB_NAME}" \
                    python3 generate_site.py
                '''
            }
        }

        stage('Deploy') {
            steps {
                echo "Upload site/index.html to s3://${params.S3_BUCKET}/index.html"
                withCredentials([usernamePassword(
                    credentialsId: 'aws-s3-workshop',
                    usernameVariable: 'AWS_ACCESS_KEY_ID',
                    passwordVariable: 'AWS_SECRET_ACCESS_KEY'
                )]) {
                    sh '''
                        aws s3 cp "$APP_DIR/site/index.html" \
                            "s3://${S3_BUCKET}/index.html" \
                            --region "${AWS_REGION}" \
                            --content-type text/html

                        echo "Uploaded s3://${S3_BUCKET}/index.html"
                        echo "Try: http://${S3_BUCKET}.s3-website-${AWS_REGION}.amazonaws.com"
                        echo "Or:  http://${S3_BUCKET}.s3-website.${AWS_REGION}.amazonaws.com"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Deployed to s3://${params.S3_BUCKET}/index.html — open the S3 website URL from the console."
        }
        failure {
            echo 'Check: S3_BUCKET on Build with Parameters, credential ID aws-s3-workshop, AWS CLI on the agent, and bucket website hosting / public read.'
        }
    }
}
