pipeline {
    agent any

    stages {
        stage('Info') {
            steps {
                echo "Building branch: ${env.BRANCH_NAME}"
            }
        }
        stage('Run') {
            steps {
                sh 'cd demos/08-multibranch-pipeline && BRANCH_NAME="${BRANCH_NAME}" python3 app.py'
            }
        }
    }

    post {
        success {
            echo "Branch ${env.BRANCH_NAME} built successfully!"
        }
    }
}
