pipeline {
    agent any

    parameters {
        string(name: 'GREETING_NAME', defaultValue: 'World', description: 'Name to greet')
        choice(name: 'LANGUAGE', choices: ['en', 'es', 'fr', 'nigeria'], description: 'Greeting language (display only)')
    }

    stages {
        stage('Greet') {
            steps {
                echo "Language selected: ${params.LANGUAGE}"
                sh 'cd demos/06-parameterized-build && GREETING_NAME="${GREETING_NAME}" python3 greet.py'
            }
        }
    }

    post {
        success {
            echo "Greeted ${params.GREETING_NAME} successfully!"
        }
    }
}
